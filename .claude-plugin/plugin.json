{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "flavian",
  "displayName": "Flavian",
  "version": "2.0.1",
  "description": "WordPress development for Claude Code: FSE block-theme agents and skills, Figma, Canva and InDesign to FSE pipelines, a root-level layout guard, a token guard on commit, and a deploy guard that stops production deploys and local data loss for a human. The pipeline skills need a Flavian checkout; the agents, knowledge skills, hooks and the fse-template-lanes workflow work in any WordPress repo.",
  "author": {
    "name": "Paul Mulligan",
    "url": "https://pmds.info"
  },
  "homepage": "https://github.com/PMDevSolutions/Flavian",
  "repository": "https://github.com/PMDevSolutions/Flavian",
  "license": "MIT",
  "keywords": [
    "wordpress",
    "fse",
    "block-theme",
    "gutenberg",
    "figma",
    "canva",
    "indesign",
    "woocommerce",
    "design-tokens",
    "visual-qa"
  ],
  "metadata": {
    "excludedAgents": [
      "agent-expert",
      "ai-engineer",
      "analytics-reporter",
      "brand-guardian",
      "command-expert",
      "content-creator",
      "docusaurus-expert",
      "experiment-tracker",
      "feedback-synthesizer",
      "finance-tracker",
      "growth-hacker",
      "instagram-curator",
      "joker",
      "legal-compliance-checker",
      "project-shipper",
      "reddit-community-builder",
      "sprint-prioritizer",
      "studio-coach",
      "studio-producer",
      "support-responder",
      "tiktok-strategist",
      "tool-evaluator",
      "trend-researcher",
      "twitter-engager",
      "visual-storyteller",
      "workflow-optimizer"
    ],
    "excludedAgentsReason": "These 26 agents stay in the repo but do not ship in the plugin (PMDevSolutions/Flavian#167). Thirteen of them (agent-expert, command-expert, content-creator, experiment-tracker, feedback-synthesizer, joker, legal-compliance-checker, project-shipper, reddit-community-builder, sprint-prioritizer, studio-coach, support-responder, tiktok-strategist) are names the maecenas plugin already ships, so a repo with both plugins would load two agents per name; the other thirteen have no WordPress or web-engineering job. Every agent description a plugin ships is loaded into every session of the repos that install it."
  },
