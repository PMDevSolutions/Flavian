:root {
  --container: 720px;
  --fg: #111;
  --muted: #666;
  --accent: #0066cc;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  color: var(--fg);
  line-height: 1.6;
}

.container {
  max-width: var(--container);
  margin: 0 auto;
  padding: 2rem 1rem;
}

.preview-bar {
  background: #ffefc1;
  color: #5a4500;
  padding: 0.5rem 1rem;
  text-align: center;
  font-size: 0.9rem;
}

.preview-bar a {
  color: var(--accent);
  margin-left: 0.5rem;
}

.post-list {
  list-style: none;
  padding: 0;
}

.post-list li {
  border-bottom: 1px solid #eee;
  padding: 1.5rem 0;
}

.post-list h2 {
  margin: 0 0 0.25rem;
}

.post-list a {
  color: inherit;
  text-decoration: none;
}

time {
  color: var(--muted);
  font-size: 0.875rem;
}
