# Claude Code Settings
# Ignore user-specific settings but preserve shared documentation
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/
!.claude/hooks/
!.claude/validation/
!.claude/config/
!.claude/templates/
!.claude/*.md
!.claude/settings.json

# Deployment configs: example templates are tracked; real env files are not.
.claude/config/deployment/*.yml
.claude/config/deployment/*.yaml
!.claude/config/deployment/*.example.yml
!.claude/config/deployment/*.example.yaml
!.claude/config/deployment/README.md

# Claude Code temporary/user-specific files (explicitly ignored)
.claude/logs/
.claude/settings.local.json

# WordPress Development Structure
# This project uses ROOT-LEVEL folders for development:
#   - themes/       (tracked - development themes)
#   - plugins/      (tracked - development plugins)
#   - mu-plugins/   (tracked - development must-use plugins)
#
# Deployment copies in wp-content/ subdirectories are gitignored below

# WordPress Deployment Folders (DO NOT TRACK)
# Files are copied from root-level folders to wp-content/ for testing
# These are deployment artifacts and should NOT be committed
wp-content/themes/
wp-content/plugins/
wp-content/mu-plugins/

# WordPress Core Files
# If using this as wp-content, WordPress core files should be in parent directory
# These patterns catch core files if accidentally placed here
/index.php
/license.txt
/readme.html
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-config.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php
/wp-admin/
/wp-includes/

# WordPress Uploads & Cache
uploads/
upgrade/
cache/
backup-db/
backups/
*.sql
*.sql.gz

# WordPress Advanced Cache
advanced-cache.php
wp-cache-config.php
object-cache.php

# WordPress Multisite
blogs.dir/
/sites/

# Template Development - Test Files
test-theme/
test-plugin/
*.test.php
scratch/
notes/
sandbox/
experiments/

# IDE & Editor Files
.DS_Store
.vscode/
.idea/
.phpintel/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace
.project
.settings/
*.code-workspace

# Dependency Directories
node_modules/
vendor/
bower_components/

# Build & Compiled Files
*.min.js
*.min.css
/dist/
/build/
.sass-cache/
*.map

# Flavian GUI (Electron) build output
# The root /dist/ and /build/ patterns above are root-anchored and do NOT match
# nested package output, so the GUI's build dirs are listed explicitly.
packages/gui/out/
packages/gui/dist/

# Package Manager Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log
package-lock.json
yarn.lock
# pnpm-lock.yaml is tracked — required for reproducible CI installs.

# Visual regression scratch (baselines/ is tracked; actual/, diffs/, report are not)
tests/visual/actual/
tests/visual/diffs/
tests/visual/report.json

# Lighthouse CI scratch — local report output
.lighthouseci/
composer.lock

# Environment & Config Files
.env
.env.local
.env.*.local
wp-config-local.php
local-config.php

# Temporary Files
*.tmp
*.bak
*.log
.cache/
.temp/
*.pid
*.seed
*.pid.lock

# Docker benchmark results
docker-benchmark-results.txt

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Security & Sensitive Data
*.pem
*.key
*.cert
.htaccess.bak
.htpasswd

# WordPress Debug Logs
debug.log
error_log
wp-errors.log
php_errors.log

# PHPUnit & Testing
/tests/phpunit/
phpunit.xml
.phpunit.result.cache
coverage/
.coverage
htmlcov/

# Code Quality Tools
.phpcs.xml.cache
.php_cs.cache
.php-cs-fixer.cache

# Documentation Build Files
/docs/_build/
/docs/.sass-cache/

# Playwright (cross-browser testing)
.playwright/
playwright-report/

# Visual QA screenshots (generated by visual-qa-agent)
.claude/visual-qa/

# Security reports (contain vulnerability details — do not commit)
.claude/security-reports/

# Taskmaster Files (if using ai-taskmaster)
.taskmaster/tasks/*.json.bak
.taskmaster/logs/

# Comments
# This .gitignore is designed for WordPress theme/plugin development
# Development happens in root-level themes/, plugins/, mu-plugins/ folders (tracked)
# Deployment copies in wp-content/ subdirectories are ignored (not tracked)
# It excludes Claude Code user settings but preserves shared documentation and validation scripts
# Adjust patterns based on your specific workflow needs
